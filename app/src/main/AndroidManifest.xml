<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.transaction">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Transaction">

        <!-- 🚀 Launcher / Entry Point -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🏠 Dashboard (Before Login) -->
        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="true" />

        <!-- 🔐 Authentication -->
        <activity
            android:name=".login.LoginActivity"
            android:exported="true" />

        <activity
            android:name=".login.ForgotPasswordActivity"
            android:exported="true" />

        <activity
            android:name=".login.ResetPasswordActivity"
            android:exported="true" />

        <activity
            android:name=".register.RegisterActivity"
            android:exported="true" />

        <!-- 📋 Main Menu (After Login) -->
        <activity
            android:name=".mainMenu.MainMenuActivity"
            android:exported="true" />

        <!-- 💰 Salary Flow -->
        <activity
            android:name=".salaryInput.SalaryInputActivity"
            android:exported="true" />

        <activity
            android:name=".salaryInput.SummaryActivity"
            android:exported="true" />

        <!-- ➕ Add Transaction -->
        <activity
            android:name=".add_trans1.AddTrans1Activity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".add_trans2.CategorizationActivity"
            android:exported="true" />

        <!-- 📊 Graphs & History -->
        <activity
            android:name=".graphHistory.GraphActivity"
            android:exported="true" />

        <!-- 👀 View Expenses -->
        <activity
            android:name=".view_exp.ViewExpenseActivity"
            android:exported="true" />

        <!-- 🗂 Categories -->
        <activity
            android:name=".CategoryActivity"
            android:exported="true" />

        <!-- 📘 Tutorial -->
        <activity
            android:name=".tutorial.TutorialActivity"
            android:exported="true" />

    </application>

</manifest>
